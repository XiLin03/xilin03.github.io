---
import { siteConfig, publications, contributionMarks, industry } from '../config';
import '../styles/global.css';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={siteConfig.description} />
    <meta name="theme-color" content="#faf9f6" />
    <meta property="og:title" content="Xi Lin — Robot Learning & Embodied AI" />
    <meta property="og:description" content={siteConfig.description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://xilin03.github.io/" />
    <link rel="canonical" href="https://xilin03.github.io/" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Newsreader:opsz,wght@6..72,400;6..72,500&display=swap" rel="stylesheet" />
    <title>Xi Lin — Robot Learning &amp; Embodied AI</title>
  </head>
  <body>
    <a class="skip-link" href="#publications">Skip to publications</a>
    <main>
      <header class="opening">
        <h1>Xi Lin<span class="name-period" aria-hidden="true">.</span></h1>
        <p>I am an M.S. student in Robotics at <strong>Johns Hopkins University</strong>, focusing on <strong>embodied foundation models for robot manipulation</strong>.</p>
        <p>I am currently working on <strong>agent-guided world-action models</strong> with <strong>Prof. Jiachen Li</strong> at Georgia Tech. I am also collaborating with Dr. Ji Zhang at the CMU Robotics Institute on agentic VLA research.</p>
        <p>I will also be joining <strong>Meituan LongCat</strong> as a research intern, focusing on embodied foundation-model pretraining.</p>
        <p class="application-status">Seeking Fall 2027 Ph.D. opportunities.</p>
        <nav class="contact-links" aria-label="Contact and profiles">
          <a href={`mailto:${siteConfig.social.email}`}>Email</a><span aria-hidden="true">·</span>
          <a href={siteConfig.social.scholar}>Google Scholar</a><span aria-hidden="true">·</span>
          <a href={siteConfig.social.linkedin}>LinkedIn</a><span aria-hidden="true">·</span>
          <a href={siteConfig.social.cv}>CV</a>
        </nav>
      </header>
      <section id="publications" aria-labelledby="publications-title">
        <h2 id="publications-title">Selected Publications</h2>
        <div class="publications">
          {publications.map(publication => (
            <article class="publication">
              <h3>{publication.title}</h3>
              <p class="authors">{publication.authors.map((author, index) => <>{index > 0 && ', '}<span class="author-name">{author === 'Xi Lin' ? <strong>{author}</strong> : author}{contributionMarks[publication.url || publication.title]?.[author] && <sup>{contributionMarks[publication.url || publication.title][author]}</sup>}</span></>)}</p>
              <p class="publication-meta"><span>{publication.venue}</span>{publication.role && <><span class="separator" aria-hidden="true">·</span><span>{publication.role}</span></>}{publication.url && <><span class="separator" aria-hidden="true">·</span><a href={publication.url} aria-label={`Read ${publication.title} on arXiv`}>arXiv</a></>}{publication.page && <><span class="separator" aria-hidden="true">·</span><a href={publication.page} aria-label={`Visit the project page for ${publication.title}`}>Page</a></>}</p>
            </article>
          ))}
        </div>
        <div class="contribution-notes">
          <p>* Equal contribution</p>
          <p>Dual-Anchoring: <sup>†</sup> Equal contribution. <sup>‡</sup> These authors contributed equally.</p>
        </div>
      </section>
      <section class="industry" aria-labelledby="industry-title">
        <h2 id="industry-title">Industry Experience</h2>
        <ol class="timeline">{industry.map(item => <li><p class="experience-date">{item.date}</p><p class="experience-company"><strong>{item.company}</strong></p><p class="experience-description">{item.description}</p></li>)}</ol>
      </section>
      <footer><span>© {new Date().getFullYear()} Xi Lin</span><span class="footer-research">Embodied Foundation Model &amp; Robot Learning</span></footer>
    </main>
  </body>
</html>
